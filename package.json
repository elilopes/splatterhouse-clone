{
  "name": "splatterhouse",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/API run dev",
    "build": "npm --prefix apps/web run build && npm --prefix apps/API run build",
    "lint": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/API/tsconfig.json",
    "android:add": "npm --prefix apps/web run android:add",
    "android:sync": "npm --prefix apps/web run android:sync"
  }
}
